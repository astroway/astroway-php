{
  "name": "astroway/sdk",
  "description": "Official PHP SDK for the AstroWay API — natal, synastry, transits, Vedic, Human Design, Tarot, Numerology, AI horoscopes. Type-safe, retry-aware, OpenAPI 3.1 generated.",
  "keywords": [
    "astrology",
    "api",
    "sdk",
    "natal-chart",
    "synastry",
    "vedic",
    "human-design",
    "tarot",
    "numerology",
    "swiss-ephemeris",
    "openapi"
  ],
  "license": "MIT",
  "type": "library",
  "homepage": "https://api.astroway.info/docs/",
  "authors": [
    { "name": "AstroWay", "email": "astroway.info@gmail.com" }
  ],
  "support": {
    "issues": "https://github.com/astroway/astroway-php/issues",
    "source": "https://github.com/astroway/astroway-php"
  },
  "require": {
    "php": "^8.1",
    "guzzlehttp/guzzle": "^7.8",
    "psr/http-client": "^1.0",
    "psr/http-message": "^1.1 || ^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.11",
    "friendsofphp/php-cs-fixer": "^3.62"
  },
  "autoload": {
    "psr-4": {
      "Astroway\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Astroway\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  },
  "scripts": {
    "test": "phpunit",
    "stan": "phpstan analyse src --level=6",
    "lint": "php-cs-fixer fix --dry-run --diff"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.1.x-dev"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
